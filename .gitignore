# Dependencies
node_modules/

# Build output (generated by Vite — rebuild with `npm run build`)
theme/build/
plugin/build/
plugin-marketplace/build/

# Vite
.vite/
*.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Local-only docs, AI references, scratch plans (rule: never pushed)
/doc/
CLAUDE.md
*.local.md

# Database dumps and uploads — never in the repo
*.sql
*.sql.gz
wp-content/
uploads/

# Template packages / client asset drops
/dist-themes/
*.zip

# Self-hosted webfonts are dropped in by hand (see doc/FONTS.md), not committed
theme/assets/fonts/*.woff2

# Agent skills installed locally — never committed (see doc/SKILLS.md)
.claude/

# Deploy keypair — generated locally, never committed (see DEPLOYMENT.md)
fm-deploy
fm-deploy.pub
