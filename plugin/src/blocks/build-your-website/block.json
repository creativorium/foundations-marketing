{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/build-your-website",
  "title": "Build Your Website",
  "category": "foundations",
  "icon": "layout",
  "description": "A landing section based on the Build Your Website mockup.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": false
  },
  "attributes": {
    "topbarText": { "type": "string", "default": "Your new website starts here — choose a direction and make it yours." },
    "logoText": { "type": "string", "default": "Foundations." },
    "navLinkOne": { "type": "string", "default": "Templates" },
    "navLinkTwo": { "type": "string", "default": "What's Included" },
    "navLinkThree": { "type": "string", "default": "Support" },
    "navLinkOneUrl": { "type": "string", "default": "#templates" },
    "navLinkTwoUrl": { "type": "string", "default": "#features" },
    "navLinkThreeUrl": { "type": "string", "default": "#support" },
    "primaryButtonText": { "type": "string", "default": "Build My Site →" },
    "primaryButtonUrl": { "type": "string", "default": "#templates" },
    "eyebrow": { "type": "string", "default": "Build your website" },
    "heading": { "type": "string", "default": "Your business deserves a site that" },
    "headingAccent": { "type": "string", "default": "feels like you." },
    "lede": { "type": "string", "default": "Pick a starting point, customize your content and turn your ideas into a website you're actually proud to share." },
    "heroPrimaryText": { "type": "string", "default": "Choose your template" },
    "heroPrimaryUrl": { "type": "string", "default": "#templates" },
    "heroSecondaryText": { "type": "string", "default": "See what's included" },
    "heroSecondaryUrl": { "type": "string", "default": "#features" },
    "journeyTitle": { "type": "string", "default": "Your journey" },
    "journeyStepOne": { "type": "string", "default": "Choose style" },
    "journeyStepTwo": { "type": "string", "default": "Add content" },
    "journeyStepThree": { "type": "string", "default": "Customize" },
    "journeyStepFour": { "type": "string", "default": "Launch" },
    "sectionHeading": { "type": "string", "default": "Start with a look that speaks your language." },
    "sectionIntro": { "type": "string", "default": "These layouts are designed as flexible starting points. Choose the direction closest to your brand." },
    "featuresTitle": { "type": "string", "default": "More than just a pretty homepage." },
    "featuresIntro": { "type": "string", "default": "Everything you need" },
    "ctaHeading": { "type": "string", "default": "Ready to make your corner of the internet?" },
    "ctaText": { "type": "string", "default": "Choose your starting point and we'll take it from there." },
    "ctaButtonText": { "type": "string", "default": "Start building →" },
    "ctaButtonUrl": { "type": "string", "default": "#templates" },
    "footerLogo": { "type": "string", "default": "Foundations." },
    "footerCopy": { "type": "string", "default": "© 2026 Foundations Marketing" }
  },
  "render": "file:./render.php"
}
