{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/steps",
  "title": "Steps",
  "category": "foundations",
  "icon": "editor-ol",
  "description": "Numbered process cards on rotating tints.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "number":  { "type": "string", "default": "03" },
    "label":   { "type": "string", "default": "The process" },
    "aside":   { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "items":   { "type": "array",  "default": [] }
  },
  "render": "file:./render.php"
}
