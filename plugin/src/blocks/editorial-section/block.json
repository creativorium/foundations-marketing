{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/editorial-section",
  "title": "Editorial section",
  "category": "foundations",
  "icon": "align-wide",
  "description": "Editorial section with editable content and token-based styling.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "stack"
    },
    "tone": {
      "type": "string",
      "default": "paper"
    }
  },
  "render": "file:./render.php"
}
