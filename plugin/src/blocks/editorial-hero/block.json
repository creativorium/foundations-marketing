{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/editorial-hero",
  "title": "Editorial photo hero",
  "category": "foundations",
  "icon": "cover-image",
  "description": "Editorial photo hero with editable content and token-based styling.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "fallbackImage": {
      "type": "string",
      "default": ""
    },
    "accentText": {
      "type": "string",
      "default": ""
    },
    "headingEnd": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "split"
    },
    "primaryText": {
      "type": "string",
      "default": ""
    },
    "primaryUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryText": {
      "type": "string",
      "default": ""
    },
    "secondaryUrl": {
      "type": "string",
      "default": ""
    },
    "footnote": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php"
}
