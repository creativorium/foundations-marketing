{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/editorial-frame",
  "title": "Editorial canvas",
  "category": "foundations",
  "icon": "layout",
  "description": "Editorial canvas with editable content and token-based styling.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true,
    "multiple": false
  },
  "attributes": {
    "paper": {
      "type": "string",
      "default": ""
    },
    "ink": {
      "type": "string",
      "default": ""
    },
    "accent": {
      "type": "string",
      "default": ""
    },
    "panel": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php"
}
