{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/benefits",
  "title": "Benefits",
  "category": "foundations",
  "icon": "list-view",
  "description": "Numbered two-column list of reasons to buy.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "number":  { "type": "string", "default": "04" },
    "label":   { "type": "string", "default": "Why us" },
    "aside":   { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "items":   { "type": "array",  "default": [] }
  },
  "render": "file:./render.php"
}
