{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/template-grid",
  "title": "Template grid",
  "category": "foundations",
  "icon": "grid-view",
  "description": "The catalogue of site templates, read live from the Site Templates you have published.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "number":   { "type": "string", "default": "01" },
    "label":    { "type": "string", "default": "The templates" },
    "aside":    { "type": "string", "default": "Browse by niche" },
    "heading":  { "type": "string", "default": "" },
    "intro":    { "type": "string", "default": "" },
    "priceFrom":{ "type": "string", "default": "From \u00a3249" },
    "limit":    { "type": "number", "default": 9 }
  },
  "render": "file:./render.php"
}
