{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/editorial-timetable",
  "title": "Weekly timetable",
  "category": "foundations",
  "icon": "calendar-alt",
  "description": "Weekly timetable with editable content and token-based styling.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "days": {
      "type": "array",
      "default": []
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./render.php"
}
