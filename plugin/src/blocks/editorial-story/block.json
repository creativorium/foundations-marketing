{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/editorial-story",
  "title": "Editorial story",
  "category": "foundations",
  "icon": "format-image",
  "description": "Editorial story with editable content and token-based styling.",
  "textdomain": "foundations",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "mediaId": {
      "type": "number",
      "default": 0
    },
    "mediaAlt": {
      "type": "string",
      "default": ""
    },
    "fallbackImage": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "profile"
    },
    "paragraphs": {
      "type": "array",
      "default": []
    },
    "items": {
      "type": "array",
      "default": []
    },
    "gallery": {
      "type": "array",
      "default": []
    }
  },
  "render": "file:./render.php"
}
