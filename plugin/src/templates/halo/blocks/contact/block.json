{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/halo-contact",
  "title": "Halo — Enquiry",
  "category": "foundations-halo",
  "icon": "email",
  "description": "\"Tell me about your skin\" — the enquiry form beside a studio photograph.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "lead": { "type": "string", "default": "" },
    "action": { "type": "string", "default": "" },
    "interestLabel": { "type": "string", "default": "" },
    "interests": { "type": "array", "default": [] },
    "messageLabel": { "type": "string", "default": "" },
    "submitLabel": { "type": "string", "default": "" },
    "imageId": { "type": "number", "default": 0 },
    "imageAlt": { "type": "string", "default": "" },
    "imageNote": { "type": "string", "default": "" },
    "placeholder": { "type": "boolean", "default": false }
  },
  "render": "file:./render.php"
}
