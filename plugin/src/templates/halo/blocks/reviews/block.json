{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/halo-reviews",
  "title": "Halo — Reviews",
  "category": "foundations-halo",
  "icon": "format-quote",
  "description": "What clients say, as a wall of short quotes with who said each one.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "eyebrow": { "type": "string", "default": "" },
    "heading": { "type": "string", "default": "" },
    "quotes": { "type": "array", "default": [] }
  },
  "render": "file:./render.php"
}
