{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "$comment": "Halo's palette, type and spacing, read straight off the client canvas. The packager copies this over the base's theme.json, and theme-customer-base/style.css aliases every preset to an --fm-* token, so the blocks in this folder never name a hex. Presets this design adds beyond the shared seven are aliased in style.scss.",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "46rem",
      "wideSize": "82rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customDuotone": false,
      "palette": [
        { "slug": "canvas", "color": "#f1f2ec", "name": "Canvas" },
        { "slug": "surface", "color": "#f7f8f3", "name": "Surface" },
        { "slug": "band", "color": "#e4e7dc", "name": "Band" },
        { "slug": "ink", "color": "#2a3128", "name": "Ink" },
        { "slug": "muted", "color": "#55604f", "name": "Muted" },
        { "slug": "soft", "color": "#7e8878", "name": "Soft" },
        { "slug": "line", "color": "#d8dcce", "name": "Line" },
        { "slug": "accent", "color": "#93a187", "name": "Accent" },
        { "slug": "accent-deep", "color": "#7f9068", "name": "Accent deep" },
        { "slug": "on-accent", "color": "#f1f2ec", "name": "On accent" },
        { "slug": "inverse", "color": "#2a3128", "name": "Inverse" },
        { "slug": "on-inverse", "color": "#f1f2ec", "name": "On inverse" },
        { "slug": "inverse-muted", "color": "#b6bfaf", "name": "Inverse muted" },
        { "slug": "inverse-line", "color": "#46503f", "name": "Inverse line" },
        { "slug": "inverse-soft", "color": "#7d8a76", "name": "Inverse soft" },
        { "slug": "inverse-accent", "color": "#c7d4b6", "name": "Inverse accent" },
        { "slug": "warm", "color": "#c0a88f", "name": "Warm" },
        { "slug": "placeholder", "color": "#e4e7dc", "name": "Placeholder" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": true,
      "$fonts": "Both families are bundled as Latin woff2 in assets/fonts/, extracted from the client's own canvas file for visual parity — see that folder's README. Each still names a real system fallback, so the design is legible before a byte is downloaded, and neither points at a third-party CDN: theme-customer-base/inc/assets.php forbids it on a customer site.",
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "'Instrument Serif', Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.75rem" },
        { "slug": "medium", "name": "Medium", "size": "0.9375rem" },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.0625rem",
          "fluid": { "min": "1rem", "max": "1.125rem" }
        },
        {
          "slug": "x-large",
          "name": "X Large",
          "size": "2rem",
          "fluid": { "min": "1.625rem", "max": "2.25rem" }
        },
        {
          "slug": "xx-large",
          "name": "XX Large",
          "size": "3.5rem",
          "fluid": { "min": "2.25rem", "max": "3.75rem" }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "5.375rem",
          "fluid": { "min": "2.75rem", "max": "5.375rem" }
        }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "units": ["rem", "px", "%", "vw"],
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.5rem" },
        { "slug": "20", "name": "2", "size": "1rem" },
        { "slug": "30", "name": "3", "size": "1.5rem" },
        { "slug": "40", "name": "4", "size": "2.5rem" },
        { "slug": "50", "name": "5", "size": "4.5rem" },
        { "slug": "60", "name": "6", "size": "7rem" }
      ]
    },
    "border": { "radius": true, "color": true, "style": true, "width": true }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "0",
      "padding": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-deep)" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.04",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "0.98",
          "letterSpacing": "-0.02em"
        }
      },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--on-inverse)"
        },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "500" },
        "spacing": {
          "padding": {
            "top": "0.95rem",
            "bottom": "0.95rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
