{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "60rem", "wideSize": "90rem" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "slug": "background", "color": "#271018", "name": "Ember background" },
        { "slug": "surface", "color": "#321420", "name": "Ember surface" },
        { "slug": "deep", "color": "#1c0a10", "name": "Ember deep" },
        { "slug": "cream", "color": "#f0e8d6", "name": "Ember cream" },
        { "slug": "muted", "color": "#c8bca8", "name": "Ember muted" },
        { "slug": "rust", "color": "#b8563c", "name": "Ember rust" },
        { "slug": "gold", "color": "#c8a870", "name": "Ember gold" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        { "slug": "display", "name": "Cormorant Garamond", "fontFamily": "'Ember Cormorant', Georgia, serif" },
        { "slug": "body", "name": "DM Sans", "fontFamily": "'Ember DM Sans', system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.75rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "display", "name": "Display", "size": "5rem" }
      ]
    },
    "spacing": { "customSpacingSize": false, "units": ["rem", "px", "%", "vw"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--cream)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "300", "lineHeight": "1.5" },
    "spacing": { "blockGap": "0", "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontStyle": "italic", "fontWeight": "300" } },
      "link": { "color": { "text": "var(--wp--preset--color--cream)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
