{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "$comment": "Onyx's palette, type and spacing. The packager copies this over the base's theme.json, and theme-customer-base/style.css aliases every preset to an --fm-* token, so the blocks in this folder never name a hex. Extra presets this design adds are aliased in style.scss.",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "44rem",
      "wideSize": "84rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customDuotone": false,
      "palette": [
        {
          "slug": "canvas",
          "color": "#f7f8f8",
          "name": "Canvas"
        },
        {
          "slug": "surface",
          "color": "#ffffff",
          "name": "Surface"
        },
        {
          "slug": "ink",
          "color": "#101010",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#63686e",
          "name": "Muted"
        },
        {
          "slug": "line",
          "color": "#e2e4e6",
          "name": "Line"
        },
        {
          "slug": "accent",
          "color": "#4d5c75",
          "name": "Accent"
        },
        {
          "slug": "accent-soft",
          "color": "#7e8ca3",
          "name": "Accent soft"
        },
        {
          "slug": "on-accent",
          "color": "#f7f8f8",
          "name": "On accent"
        },
        {
          "slug": "inverse",
          "color": "#101010",
          "name": "Inverse"
        },
        {
          "slug": "on-inverse",
          "color": "#f7f8f8",
          "name": "On inverse"
        },
        {
          "slug": "inverse-muted",
          "color": "#a9aeb4",
          "name": "Inverse muted"
        },
        {
          "slug": "inverse-line",
          "color": "#2c2f32",
          "name": "Inverse line"
        },
        {
          "slug": "placeholder",
          "color": "#eaecee",
          "name": "Placeholder"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": true,
      "$fonts": "Font FILES are not bundled — see the template README. Both families fall back to a real system stack, so the design is legible with nothing downloaded. Never point these at a third-party CDN: theme-customer-base/inc/assets.php forbids it on a customer site.",
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Display",
          "fontFamily": "Archivo, 'Helvetica Neue', Helvetica, Arial, sans-serif"
        },
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.8125rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "0.9375rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.1875rem"
          }
        },
        {
          "slug": "x-large",
          "name": "X Large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "XX Large",
          "size": "3.25rem",
          "fluid": {
            "min": "2rem",
            "max": "3.25rem"
          }
        }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "units": [
        "rem",
        "px",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "10",
          "name": "1",
          "size": "0.5rem"
        },
        {
          "slug": "20",
          "name": "2",
          "size": "1rem"
        },
        {
          "slug": "30",
          "name": "3",
          "size": "1.5rem"
        },
        {
          "slug": "40",
          "name": "4",
          "size": "2.5rem"
        },
        {
          "slug": "50",
          "name": "5",
          "size": "4.5rem"
        },
        {
          "slug": "60",
          "name": "6",
          "size": "6.875rem"
        }
      ]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "0",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "0",
        "right": "0"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500",
          "lineHeight": "1.02",
          "letterSpacing": "-0.03em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "0.9",
          "letterSpacing": "-0.045em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--on-accent)"
        },
        "border": {
          "radius": "0.375rem"
        },
        "typography": {
          "fontWeight": "500"
        },
        "spacing": {
          "padding": {
            "top": "0.8rem",
            "bottom": "0.8rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
