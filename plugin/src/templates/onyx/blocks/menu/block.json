{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/onyx-menu",
  "title": "Onyx — Treatment menu",
  "category": "foundations-onyx",
  "icon": "list-view",
  "description": "The priced treatment list, grouped, each row carrying a description, a duration and a price. Closes with a booking prompt.",
  "textdomain": "foundations",
  "supports": { "html": false, "anchor": true },
  "attributes": {
    "groups":     { "type": "array",  "default": [] },
    "footNote":   { "type": "string", "default": "" },
    "ctaLabel":   { "type": "string", "default": "" },
    "ctaUrl":     { "type": "string", "default": "" }
  },
  "render": "file:./render.php"
}
