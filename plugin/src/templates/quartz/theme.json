{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "60rem", "wideSize": "90rem" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "palette": [
        { "slug": "canvas", "name": "Ice", "color": "#EDF6FA" },
        { "slug": "surface", "name": "Cream", "color": "#FAFAF8" },
        { "slug": "ink", "name": "Night", "color": "#1A1A1A" },
        { "slug": "body", "name": "Body text", "color": "#3A3A3A" },
        { "slug": "muted", "name": "Muted text", "color": "#6A6A6A" },
        { "slug": "line", "name": "Light blue", "color": "#A8D4E6" },
        { "slug": "accent", "name": "Terra", "color": "#A9573F" },
        { "slug": "on-accent", "name": "White", "color": "#FFFFFF" },
        { "slug": "deep", "name": "Deep blue", "color": "#1E4D63" },
        { "slug": "steel", "name": "Steel blue", "color": "#2A6B88" },
        { "slug": "mid", "name": "Mid blue", "color": "#5B9BB5" },
        { "slug": "pale", "name": "Pale blue", "color": "#D4ECF5" },
        { "slug": "terra-bright", "name": "Terra (decorative)", "color": "#C06B52" },
        { "slug": "terra-light", "name": "Light terra", "color": "#EDB0A2" },
        { "slug": "mist", "name": "Mist", "color": "#C8D8E0" },
        { "slug": "slate", "name": "Slate", "color": "#A0B8C8" },
        { "slug": "sand", "name": "Sand", "color": "#D0C0B8" },
        { "slug": "clay", "name": "Clay", "color": "#B8A098" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fontFamilies": [
        { "slug": "display", "name": "Cormorant Garamond", "fontFamily": "'Quartz Cormorant', Georgia, serif" },
        { "slug": "body", "name": "DM Sans", "fontFamily": "'Quartz DM Sans', system-ui, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.8125rem" },
        { "slug": "medium", "name": "Medium", "size": "0.9375rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Extra large", "size": "clamp(1.875rem, 3vw, 3rem)" },
        { "slug": "xx-large", "name": "Huge", "size": "clamp(2.75rem, 4.5vw, 4.25rem)" }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.5rem" },
        { "slug": "20", "name": "2", "size": "1rem" },
        { "slug": "30", "name": "3", "size": "1.5rem" },
        { "slug": "40", "name": "4", "size": "2.5rem" },
        { "slug": "50", "name": "5", "size": "4.5rem" },
        { "slug": "60", "name": "6", "size": "6rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--canvas)", "text": "var(--wp--preset--color--body)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65" },
    "spacing": { "blockGap": "0", "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
