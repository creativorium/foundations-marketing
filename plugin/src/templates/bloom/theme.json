{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize":"62.5rem","wideSize":"87.5rem"},
    "color": {
      "defaultPalette": false,
      "custom": false,
      "palette": [
        {"slug":"paper","name":"Paper","color":"#F5EFE6"},
        {"slug":"paper-soft","name":"Soft paper","color":"#EDE4D8"},
        {"slug":"forest","name":"Forest","color":"#253B2C"},
        {"slug":"forest-deep","name":"Deep forest","color":"#1C2E22"},
        {"slug":"sage","name":"Sage","color":"#7A9E7E"},
        {"slug":"clay","name":"Clay","color":"#C08060"},
        {"slug":"ink","name":"Ink","color":"#1C1A16"}
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": false,
      "fontFamilies": [
        {"slug":"display","name":"Cormorant Garamond","fontFamily":"'Bloom Cormorant', Georgia, serif"},
        {"slug":"body","name":"Inter","fontFamily":"'Bloom Inter', Arial, sans-serif"}
      ]
    }
  },
  "styles": {
    "color": {"background":"var(--wp--preset--color--paper)","text":"var(--wp--preset--color--ink)"},
    "typography": {"fontFamily":"var(--wp--preset--font-family--body)"},
    "spacing": {"blockGap":"0"}
  },
  "templateParts": [
    {"name":"header","title":"Header","area":"header"},
    {"name":"footer","title":"Footer","area":"footer"}
  ]
}
