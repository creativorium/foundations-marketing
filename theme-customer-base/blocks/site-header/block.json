{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "foundations/site-header",
  "title": "Site header",
  "category": "theme",
  "description": "The site header. Layout is fixed by the design; content comes from Site Settings.",
  "textdomain": "foundations-customer",
  "supports": {
    "html": false,
    "reusable": false,
    "multiple": false,
    "inserter": false,
    "lock": false
  },
  "attributes": {
    "variant": {
      "type": "string",
      "default": "inline",
      "enum": ["inline", "centered", "stacked"]
    },
    "showCta": {
      "type": "boolean",
      "default": true
    }
  },
  "render": "file:./render.php"
}
